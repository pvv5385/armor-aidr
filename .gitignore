/target
*.log

# Local docker-compose overrides — copy from .env.example. May hold a real
# ARMOR_INFERENCE_AUTH_TOKEN; never commit it.
/.env

__pycache__/
*.pyc
*.old

# `inference/` build and test artifacts.
*.egg-info/
.pytest_cache/
.ruff_cache/
/inference/build/
/inference/dist/
/inference/.venv/

# The default bind-mount target for model weights
# (ARMOR_MODELS_DIR=./models docker compose --profile ml up). Weights are
# gigabytes and are pinned by digest, not by version control.
/models/

# Operator-authored config. Each of these is what you get by following a
# shipped `.yaml.example` ("copy this, drop the .example suffix"), so they
# are deployment-specific by construction — an application_id mapping, a
# tuned profile, a house ruleset — and can carry identifiers you did not
# mean to publish. The `.example` templates themselves end in
# `.yaml.example`, so none of these patterns match them, and the shipped
# defaults (`config/policies.yaml`, `config/ml_catalog.yaml`,
# `config/benchmarks/`, `config/packs/`) stay tracked.
/config/applications.yaml
/config/profiles/*.yaml
/config/custom_rules/*.yaml
